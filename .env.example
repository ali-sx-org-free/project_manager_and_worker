# 複製成 .env 再填：cp .env.example .env

# 協調服務的域名（不帶 https://），要先在 DNS 裡指向這台服務器的公網 IP。
# 沒有域名時可以用 sslip.io：把 IP 的點換成橫線，例如公網 IP 是 34.80.12.5 就填 34-80-12-5.sslip.io
PM_DOMAIN=pm.example.com

# 管理員 token。用 openssl rand -hex 24 產生一串，不要用範例裡的字。
PM_TOKEN=

# worker 斷線多久後，它的任務交給別人接手（毫秒）。180000 是 3 分鐘。
LEASE_MS=180000
